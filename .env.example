# Copy to .env. The app runs with everything here left blank, but photo scanning
# needs a vision-capable provider key. Groq handles both photos and coaching.

# Free-tier key: https://aistudio.google.com/apikey (optional backup)
GEMINI_API_KEY=
# Free-tier key: https://console.groq.com/keys (photos and coaching)
GROQ_API_KEY=

# Leave blank to use the built-in local database. Set this for MongoDB Atlas.
MONGODB_URI=

# Required in production. Generated automatically in development.
JWT_SECRET=

PORT=5000
APP_TIMEZONE=Asia/Kolkata

# Provider model IDs change often. Run "npm run check:ai" to test these.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
# Meal photos use Groq first; Gemini remains a backup when its key is configured.
VISION_PROVIDER=groq
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Evening "what is left today" emails. Leave SMTP_HOST blank to write them to server/.data/outbox.log instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FitMentor <no-reply@fitmentor.ai>
APP_URL=http://localhost:5173
